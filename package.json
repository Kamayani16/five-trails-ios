{
  "name": "five-trails-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Five Trails for iPhone: the web game in a Capacitor shell, with App Store coin packs and local reminders.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "sync": "npm run build && npx cap sync ios",
    "open": "npx cap open ios",
    "update-game": "git submodule update --init --remote game"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/local-notifications": "^8.3.1",
    "capacitor-plugin-cdv-purchase": "^13.19.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "esbuild": "^0.28.2"
  }
}
